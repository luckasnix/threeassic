{
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno run -A npm:vite",
    "build": "deno check && deno run -A npm:vite build",
    "desktop": "deno desktop .",
    "preview": "deno run -A npm:vite preview"
  },
  "desktop": {
    "app": {
      "name": "Threeassic",
      "icons": {
        "windows": "./public/favicon.ico",
        "linux": "./public/android-chrome-512x512.png",
        "macos": "./public/android-chrome-512x512.png"
      }
    },
    "backend": "cef",
    "output": {
      "macos": "./dist-desktop/macos/Threeassic.app",
      "windows": "./dist-desktop/windows/Threeassic",
      "linux": "./dist-desktop/linux/threeassic"
    }
  },
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["vite/client"],
    "verbatimModuleSyntax": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "imports": {
    "@dimforge/rapier3d": "npm:@dimforge/rapier3d@0.20.0",
    "@types/three": "npm:@types/three@0.185.4",
    "three": "npm:three@0.185.1",
    "three-gamepad-controls": "npm:three-gamepad-controls@0.22.0",
    "vite": "npm:vite@8.2.1"
  }
}
